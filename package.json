{
  "name": "ocarina-hero",
  "version": "0.2.1",
  "description": "Un ocarina \u00e0 cinq touches",
  "author": "keno681",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64",
    "test": "node --test test/*.cjs"
  },
  "build": {
    "appId": "com.keno681.ocarinahero",
    "productName": "Ocarina Hero",
    "files": [
      "desktop/**/*",
      "index.html",
      "app.js",
      "style.css",
      "package.json",
      "gamepad.js"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Ocarina-Hero-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  }
}
